# Database (PostgreSQL)
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=slotly

# Auto-create tables (true for Docker, use false + migrations in production)
DB_SYNCHRONIZE=true

# JWT (required for server)
JWT_SECRET=your-secret-key-change-in-production-min-32-chars

# JWT token expiration (optional)
JWT_ACCESS_TOKEN_EXPIRES_IN=30m
JWT_REFRESH_TOKEN_EXPIRES_IN=7d
